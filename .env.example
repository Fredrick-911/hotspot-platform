# Copy to .env (the setup scripts do this for you and fill in random secrets).
# NEVER commit .env — it is listed in .gitignore.

# --- Go API ---
APP_ENV=development
HTTP_PORT=8080
DATABASE_URL=postgres://radius:radius@127.0.0.1:5432/radius?sslmode=disable
APP_BASE_URL=http://127.0.0.1:8080
# Public address customers and routers use. Production example: http://78.141.207.74:8081 (or https://wifi.example.com)

# --- Dashboards and login ---
# Signs login cookies and the PayHero callback token. REQUIRED when APP_ENV is not "development".
# Generate one:  openssl rand -hex 32     (changing it logs everyone out)
SESSION_SECRET=
# First platform admin. Created once at startup if no admin exists; remove the password afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Business time zone for "today" and the sales charts.
APP_TIMEZONE=Africa/Nairobi
# Apply migrations/*.sql automatically when the API starts.
AUTO_MIGRATE=true
# Allow opening a customer page as /?tenant=name (turn off once wildcard DNS works).
ALLOW_TENANT_QUERY=true
# true ONLY when the API sits behind Caddy/nginx (then X-Forwarded-For is trusted for rate limits).
TRUST_PROXY=false
# Where routers reach FreeRADIUS (the WireGuard address of this server). Empty = host of APP_BASE_URL.
RADIUS_PUBLIC_HOST=

# --- PostgreSQL database that FreeRADIUS reads users from ---
RADIUS_DB_HOST=127.0.0.1
RADIUS_DB_PORT=5432
RADIUS_DB_NAME=radius
RADIUS_DB_USER=radius
RADIUS_DB_PASSWORD=change-me

# --- Lab MikroTik router (Phase 0 test) ---
MIKROTIK_LAB_SUBNET=192.168.88.0/24
MIKROTIK_LAB_SECRET=change-me

# --- PayHero Credentials ---
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=