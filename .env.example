# Copy to .env (the setup scripts do this for you and fill in random secrets).
# NEVER commit .env — it is listed in .gitignore.

# --- Go API ---
APP_ENV=development
HTTP_PORT=8080
DATABASE_URL=postgres://radius:radius@127.0.0.1:5432/radius?sslmode=disable
APP_BASE_URL=http://127.0.0.1:8080

# --- PostgreSQL database that FreeRADIUS reads users from ---
RADIUS_DB_HOST=127.0.0.1
RADIUS_DB_PORT=5432
RADIUS_DB_NAME=radius
RADIUS_DB_USER=radius
RADIUS_DB_PASSWORD=change-me

# --- Lab MikroTik router (Phase 0 test) ---
MIKROTIK_LAB_SUBNET=192.168.88.0/24
MIKROTIK_LAB_SECRET=change-me

# --- PayHero Credentials ---
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
